APP_NAME=Dzokoli API
APP_VERSION=0.1.0
APP_ENV=development
API_V1_PREFIX=/api/v1
DOCS_ENABLED=true
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
PROFILE_PICTURES_BUCKET=profile-pictures
PROFILE_PICTURE_MAX_BYTES=5242880
CONVERSATION_MEDIA_BUCKET=conversation-media
CONVERSATION_MEDIA_MAX_BYTES=52428800
CONVERSATION_SIGNED_URL_EXPIRES_IN=900

# Required for WebSocket broadcasting across multiple FastAPI instances.
REDIS_URL=redis://localhost:6379/0
REDIS_CONVERSATION_CHANNEL=dzokoli:conversations
